# Copy to `.env` and adjust to your machine.
# Path to the virtual environment created by SNAP's `snappy-conf`,
# i.e. the venv whose site-packages contain `esa_snappy`.
# Takes precedence over [tool.radar-snap-lib] esa-snappy-venv in pyproject.toml.
ESA_SNAPPY_VENV=/home/kjell/projects/py_projects/esa_snappy_env/.venv

# NASA Earthdata Login, needed only for `radar-snap download` -- searching works
# without an account. Register at https://urs.earthdata.nasa.gov/
# A token takes precedence over the username/password pair.
EARTHDATA_TOKEN=
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
